@using Monambike.Web.Models
@inject HttpClient Http

<h3 class="tip">@CurrentPhrase</h3>

@code {
    private string CurrentPhrase = "(˶˃ ᵕ ˂˶)/  eaeee :DD";

    protected override async Task OnInitializedAsync()
    {
        var content = await Http.GetStringAsync("data/phrases.txt");

        var phrases = content
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .ToList();

        var phrase = new Phrase(phrases);

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        while (await timer.WaitForNextTickAsync())
        {
            CurrentPhrase = phrase.GetRandomPhrase();

            await InvokeAsync(StateHasChanged);
        }
    }
}
